{
  "manifest_version": 3,
  "name": "StuDash - Student Dashboard (Beta)",
  "short_name": "StuDash",
  "version": "1.0.0",
  "description": "داشبورد جامع دانشجویی در تب جدید کروم: تقویم شمسی/میلادی، تسک روزانه، تایمر مطالعه، یادداشت سریع و سایت‌های پرکاربرد دانشگاه.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://vu.um.ac.ir/*",
    "https://oauth.um.ac.ir/*",
    "https://pooya.um.ac.ir/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_title": "StuDash",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
